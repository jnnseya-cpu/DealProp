# Copy to .env.local and fill in. Never commit a filled-in copy.

# Public base URL. Used to build confirm and unsubscribe links, which must be
# absolute and must point at the deployment that issued them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Weekly newsletter -----------------------------------------------------
# Shared secret for the cron endpoint. WITHOUT THIS THE ENDPOINT REFUSES TO
# RUN — it fails closed rather than defaulting open, because anything that can
# reach it can mail every subscriber.
# Generate: openssl rand -base64 32
CRON_SECRET=

# Email provider. All three must be set or the transport falls back to a
# logging one that sends nothing. That fallback is deliberate: a half-configured
# environment must not mail real people.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Sender identity, required by law in every marketing email.
NEWSLETTER_SENDER_NAME=
NEWSLETTER_SENDER_ADDRESS=
NEWSLETTER_REPLY_TO=

# --- Operator access -------------------------------------------------------
# Shared password for the pipeline and Deal Room. WITHOUT THIS THOSE PAGES
# REFUSE TO RENDER — they carry seller screening answers including reported
# health and capacity concerns, which is special-category personal data under
# UK GDPR Article 9, and must never default to open.
# Generate: openssl rand -base64 32
OPERATOR_SECRET=
