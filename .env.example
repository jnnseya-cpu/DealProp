# Copy to .env.local and fill in. Never commit a filled-in copy.

# Public base URL. Used to build confirm and unsubscribe links, which must be
# absolute and must point at the deployment that issued them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Weekly newsletter -----------------------------------------------------
# Shared secret for the cron endpoint. WITHOUT THIS THE ENDPOINT REFUSES TO
# RUN — it fails closed rather than defaulting open, because anything that can
# reach it can mail every subscriber.
# Generate: openssl rand -base64 32
CRON_SECRET=

# Email provider. All three must be set or the transport falls back to a
# logging one that sends nothing. That fallback is deliberate: a half-configured
# environment must not mail real people.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Sender identity, required by law in every marketing email.
NEWSLETTER_SENDER_NAME=
NEWSLETTER_SENDER_ADDRESS=
NEWSLETTER_REPLY_TO=

# --- Operator access -------------------------------------------------------
# Shared password for the pipeline and Deal Room. WITHOUT THIS THOSE PAGES
# REFUSE TO RENDER — they carry seller screening answers including reported
# health and capacity concerns, which is special-category personal data under
# UK GDPR Article 9, and must never default to open.
# Generate: openssl rand -base64 32
OPERATOR_SECRET=

# --- Persistence -----------------------------------------------------------
# Set to run on Postgres. UNSET FALLS BACK TO A JSON FILE, which is correct only
# for a single-process development server: serverless instances do not share a
# filesystem, so writes silently diverge between them. Set this on any real
# deployment.
# Example: postgres://user:pass@host:5432/lode?sslmode=require
DATABASE_URL=

# Maximum pooled connections per instance. Serverless creates one pool per
# instance, so a large value exhausts the server's connection limit.
DATABASE_POOL_MAX=5

# --- Open property data ----------------------------------------------------
# EPC register (https://epc.opendatacommunities.org). Free, but registration is
# required and the licence is accepted at registration. WITHOUT BOTH VALUES THE
# ADAPTER REFUSES TO QUERY rather than returning nothing and letting a caller
# conclude the property has no certificate.
EPC_API_EMAIL=
EPC_API_KEY=

# Land Registry Price Paid Data needs no credential: it is published under the
# Open Government Licence. Attribution is carried in code, not configured here.

# --- Blog drafting ---------------------------------------------------------
# Optional. Without these the blog uses the deterministic drafter, which
# composes posts from the engine's own reasoning and needs no network. Set both
# to have a language model write the prose — the figures are appended after the
# model returns, so it cannot change a number.
BLOG_MODEL_API_URL=
BLOG_MODEL_API_KEY=

# TLS is controlled by sslmode in the URL above, and it overrides any driver
# option. Use sslmode=require against managed Postgres. sslmode=no-verify
# encrypts but does NOT authenticate the server, so the connection can be
# intercepted — only for a self-hosted server with a self-signed certificate.

# --- Analytics -------------------------------------------------------------
# Meta Pixel and Google Tag. WITHOUT AN ID THE SCRIPT IS NEVER RENDERED, and
# even with one, nothing loads until the visitor consents and only on public
# routes — never on the pipeline, the Deal Room, the memorandum or a seller's
# own result page, which carry information given to us in confidence.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Billing ---------------------------------------------------------------
# The signing secret from the payment provider. WITHOUT IT EVERY PAYMENT
# CONFIRMATION IS REFUSED, which means nothing can be sold — and that is the
# safe direction, because this endpoint is what grants subscriptions and prepaid
# balance. Generate it nowhere: it is the provider's value, used unmodified.
# It must NOT be the same value as OPERATOR_SECRET; the preflight blocks if it
# is, since compromising either would then compromise both.
BILLING_WEBHOOK_SECRET=

# --- Funder discovery ------------------------------------------------------
# Both keys are issued to a named account against terms accepted at
# registration, and that acceptance IS the licence. WITHOUT THEM NOTHING IS
# READ — a discovered funder stays PARTIALLY_VERIFIED and cannot be approved
# for outreach. Neither source is scraped; both publish an official API.
COMPANIES_HOUSE_API_KEY=
FCA_REGISTER_EMAIL=
FCA_REGISTER_KEY=
